[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 30
prove: mode prove
prove: depth 4
cover: mode cover
cover: depth 20

[engines]
smtbmc

[script]
plugin -i ghdl
ghdl --std=08 b8008_types.vhdl instruction_register.vhdl props.vhdl -e instruction_register_props
prep -top instruction_register_props

[files]
../../src/b8008/b8008_types.vhdl
../../src/b8008/instruction_register.vhdl
props.vhdl
