[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 30
prove: mode prove
prove: depth 4
cover: mode cover
cover: depth 20

[engines]
smtbmc

[script]
plugin -i ghdl
ghdl --std=08 b8008_types.vhdl register_file.vhdl props.vhdl -e register_file_props
prep -top register_file_props

