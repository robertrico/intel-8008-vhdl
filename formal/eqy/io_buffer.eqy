# EQY equivalence: io_buffer RTL vs its write_vhdl round trip.
# Combinational module: no state to match, EQY is sound here.

[gold]
plugin -i ghdl
ghdl --std=08 src/b8008/b8008_types.vhdl src/b8008/io_buffer.vhdl -e io_buffer
synth -top io_buffer

[gate]
plugin -i ghdl
ghdl --std=08 build/synth/io_buffer_netlist.vhdl -e io_buffer
prep -top io_buffer

[strategy sat]
use sat
depth 5

[collect io_buffer]
group *
