# EQY equivalence: scratchpad_decoder RTL vs its write_vhdl round trip.
# Combinational module: no state to match, EQY is sound here.
# (Sequential modules go through the SBY miter instead; write_vhdl
# splits vector flops into scalars, which breaks EQY state matching
# and yields spurious partition failures. Proven 2026-08-07.)

[gold]
plugin -i ghdl
ghdl --std=08 src/b8008/b8008_types.vhdl src/b8008/scratchpad_decoder.vhdl -e scratchpad_decoder
synth -top scratchpad_decoder

[gate]
plugin -i ghdl
ghdl --std=08 build/synth/scratchpad_decoder_netlist.vhdl -e scratchpad_decoder
prep -top scratchpad_decoder

[strategy sat]
use sat
depth 5
