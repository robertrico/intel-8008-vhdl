# EQY equivalence: instruction_decoder RTL vs its write_vhdl round trip.
# Combinational module: no state to match, EQY is sound here.

[gold]
plugin -i ghdl
ghdl --std=08 src/b8008/b8008_types.vhdl src/b8008/instruction_decoder.vhdl -e instruction_decoder
synth -top instruction_decoder

[gate]
plugin -i ghdl
ghdl --std=08 build/synth/instruction_decoder_netlist.vhdl -e instruction_decoder
prep -top instruction_decoder

[strategy sat]
use sat
depth 5

# eval_condition alone hits a partition-support artifact (1 unused input
# on each side); exhaustive cocotb sim proves functional equality, so
# force the whole (small, combinational) module into one partition and
# let a single SAT query decide it outright.
[collect instruction_decoder]
group *
