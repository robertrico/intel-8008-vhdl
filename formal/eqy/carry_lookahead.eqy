# EQY equivalence: carry_lookahead RTL vs its write_vhdl round trip.
# Combinational module: no state to match, EQY is sound here.
# (Sequential modules go through the SBY miter instead; write_vhdl
# splits vector flops into scalars, which breaks EQY state matching
# and yields spurious partition failures. Proven 2026-08-07.)

[gold]
plugin -i ghdl
ghdl --std=08 src/b8008/b8008_types.vhdl src/b8008/carry_lookahead.vhdl -e carry_lookahead
synth -top carry_lookahead

[gate]
plugin -i ghdl
ghdl --std=08 build/synth/carry_lookahead_netlist.vhdl -e carry_lookahead
prep -top carry_lookahead

[strategy sat]
use sat
depth 5
