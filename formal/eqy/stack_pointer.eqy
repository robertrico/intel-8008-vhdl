# gold = RTL straight thru the ghdl plugin ( paths relative to
# repo root, where the make target runs eqy )
[gold]
plugin -i ghdl
ghdl --std=08 src/b8008/b8008_types.vhdl src/b8008/stack_pointer.vhdl -e stack_pointer
prep -top stack_pointer

# gate = the write_vhdl output of that same module, re-imported through the same
# plugin. if write_vhdl changed behavior, gold and gate now disagree
# and a cone fails.
[gate]
plugin -i ghdl
ghdl --std=08 build/synth/stack_pointer_netlist.vhdl -e stack_pointer
prep -top stack_pointer

# Two strats: eqy "sat" per partition, falls back to "pdr" where
# sat is inconclusive. depth = cycles of unrolling for sequential cones
[strategy sat]
use sat
depth 10

[strategy prove]
use sby
engine abc pdr
depth 10
