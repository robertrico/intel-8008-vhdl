# EQY equivalence: scratchpad_addr_mux RTL vs its write_vhdl round trip.
# Combinational module: no state to match, EQY is sound here.

[gold]
plugin -i ghdl
ghdl --std=08 src/b8008/b8008_types.vhdl src/b8008/scratchpad_addr_mux.vhdl -e scratchpad_addr_mux
synth -top scratchpad_addr_mux

[gate]
plugin -i ghdl
ghdl --std=08 build/synth/scratchpad_addr_mux_netlist.vhdl -e scratchpad_addr_mux
prep -top scratchpad_addr_mux

[strategy sat]
use sat
depth 5

[collect scratchpad_addr_mux]
group *
