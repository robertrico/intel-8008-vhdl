# EQY equivalence: sss_ddd_selector RTL vs its write_vhdl round trip.
# Combinational module: no state to match, EQY is sound here.
# (Sequential modules go through the SBY miter instead; write_vhdl
# splits vector flops into scalars, which breaks EQY state matching
# and yields spurious partition failures. Proven 2026-08-07.)

[gold]
plugin -i ghdl
ghdl --std=08 src/b8008/b8008_types.vhdl src/b8008/sss_ddd_selector.vhdl -e sss_ddd_selector
synth -top sss_ddd_selector

[gate]
plugin -i ghdl
ghdl --std=08 build/synth/sss_ddd_selector_netlist.vhdl -e sss_ddd_selector
prep -top sss_ddd_selector

[strategy sat]
use sat
depth 5
