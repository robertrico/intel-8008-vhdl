# bmc only: k-induction cannot anchor the gate netlist's split flops
# (same limitation as machine_cycle_control, see that .sby). BMC 30 is
# exhaustive over inputs per step; test-alu-exhaustive covers arithmetic
# in simulation (656384 cases).
[tasks]
bmc

[options]
bmc: mode bmc
bmc: depth 30

[engines]
smtbmc

[script]
plugin -i ghdl
ghdl --std=08 b8008_types.vhdl carry_lookahead.vhdl alu.vhdl alu_gate.vhdl miter.vhdl -e alu_miter
prep -top alu_miter

[files]
../../src/b8008/b8008_types.vhdl
../../src/b8008/carry_lookahead.vhdl
../../src/b8008/alu.vhdl
../../build/synth/alu_gate.vhdl
miter.vhdl
