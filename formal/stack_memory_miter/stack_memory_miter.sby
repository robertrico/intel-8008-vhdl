# Bounded proof only: the 8x14 slot array plus carry gives 113 state
# bits with no output visibility, so induction cannot anchor the gate
# flops (same limitation as alu_miter / machine_cycle_control).
# Depth 15 covers load/increment/carry commits and SP moves across
# slots; deeper runs blow up the SMT solver (>10 min by step 12 at
# depth 25 on an M-class laptop).
[tasks]
bmc

[options]
bmc: mode bmc
bmc: depth 15

[engines]
smtbmc

[script]
plugin -i ghdl
ghdl --std=08 b8008_types.vhdl stack_memory.vhdl stack_memory_gate.vhdl miter.vhdl -e stack_memory_miter
prep -top stack_memory_miter

[files]
../../src/b8008/b8008_types.vhdl
../../src/b8008/stack_memory.vhdl
../../build/synth/stack_memory_gate.vhdl
miter.vhdl
