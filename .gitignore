# ASM Build 
*.lst
*.hex
*.mem
# ecpbram reference image: source, not build product (see monitor rom-freeze)
!rom_baked.mem
*.p
# FPGA Build Artifacts
build/
work/
# Build reports are transient EXCEPT the timing report: docs/TIMING.md
# rows must stay backed by evidence (the 41.61 MHz report was lost).
reports/
!projects/*/reports/
projects/*/reports/*
!projects/*/reports/timing.txt

# GHDL work files
*.cf
*.o

# Waveform files
*.vcd
*.ghw
*.gtkw

# Simulation outputs
sim/output.txt

# GTKWave save files (optional - uncomment if you don't want to track them)
# sim/*.gtkw

# Bitstream and synthesis files
*.bit
*.config
*.v
!src/synth/**/*.v
# Hand-maintained primitive wrappers are sources, not build products
!src/components/pll_25mhz.v

# JSON synthesis files (but keep isa.json)
*.json
!docs/*.json

# Editor and OS files
.DS_Store
*.swp
*.swo
*~
.vscode/
.idea/

# Environment configuration (contains user-specific paths)
.env

# Temporary files
nohup.out

b8008_test.log

ram_test.log

*.log

# GHDL testbench executables (created by ghdl -e in project root)
*_tb
.superpowers/

# SBY formal task workdirs (sby -f recreates these)
formal/*/*_bmc/
formal/*/*_prove/
formal/*/*_cover/

# cocotb build artifacts. Whitelist style: GHDL drops extensionless
# elaboration executables named after the DUT (stack_pointer,
# memory_io_control, ...) directly in this directory, so ignore
# everything and re-allow the sources.
sim/cocotb/*
!sim/cocotb/Makefile
!sim/cocotb/test_*.py
!sim/cocotb/fuzz_gen.py
!sim/cocotb/fuzz_compare.py
formal/*/status.sqlite
formal/*/*/
